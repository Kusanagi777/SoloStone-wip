<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <AssemblyName>SecretScan</AssemblyName>
    <NoWarn>CS0618;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SoloStoneRoot)plugin/DungeonRun/*.cs" Exclude="$(SoloStoneRoot)plugin/DungeonRun/DungeonRunRuntime.cs;$(SoloStoneRoot)plugin/DungeonRun/DungeonRunBossPilot.cs" />
    <Compile Include="$(SoloStoneRoot)plugin/StableSeed.cs" />
    <Compile Include="$(SoloStoneRoot)plugin/NativeDungeonRunText.cs" />
    <Compile Include="$(SoloStoneRoot)plugin/Npc/World/NpcWorldJson.cs" />
    <Reference Include="SabberStoneCore">
      <HintPath>$(EngineDll)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
